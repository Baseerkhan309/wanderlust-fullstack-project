<% layout("/layouts/boilerplate") %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
  }


  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.5rem;
    padding: 1rem;
    margin-left: 5rem;
    display: flex;
    align-items: center;
  }
</style>

<div id="filters">

  <a href="/listings" class="filter <%= selectedCategory === 'All Listings' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-border-all"></i>
    </div>
    <p>All Listings</p>
  </a>


  <a href="/listings/category/Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-mountain"></i>
    </div>
    <p>Mountains</p>
  </a>


  <a href="/listings/category/Nature" class="filter <%= selectedCategory === 'Nature' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-tree"></i>
    </div>
    <p>Nature</p>
  </a>


  <a href="/listings/category/Cities" class="filter <%= selectedCategory === 'Cities' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-city"></i>
    </div>
    <p>Cities</p>
  </a>


  <a href="/listings/category/Lakes" class="filter <%= selectedCategory === 'Lakes' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-water"></i>
    </div>
    <p>Lakes</p>
  </a>

  <a href="/listings/category/Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-campground"></i>
    </div>
    <p>Camping</p>
  </a>



  <a href="/listings/category/Guest%20Houses" class="filter <%= selectedCategory === 'Guest Houses' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-house"></i>
    </div>
    <p>Guest Houses</p>
  </a>



  <a href="/listings/category/Hotels%20%26%20Resorts" class="filter <%= selectedCategory === 'Hotels & Resorts' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-hotel"></i>
    </div>
    <p>Hotels & Resorts</p>
  </a>


  <a href="/listings/category/Cottages" class="filter <%= selectedCategory === 'Cottages' ? 'active' : '' %>">
    <div>
      <i class="fa-solid fa-house-chimney"></i>
    </div>
    <p>Cottages</p>
  </a>


  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display Taxes:</label>
    </div>
  </div>
</div>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row cols-sm-1 mt-3">

  <% if(allListings.length === 0) { %>

  <div class="text-center mt-5">

    <h3>No Listings Found!</h3>

    <p class="text-muted">
      Try searching another KPK destination.
    </p>

  </div>


  <% } else { %>

  <% for(let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%= listing.images[0].url %>" class="card-img-top" alt="listing_image" style="height:20rem">

      <div class="card-img-overlay"></div>
      <div class="card-body">
        <!-- <h5 class="card-title">Card title</h5> -->

        <p class="card-text">
          <b><%= listing.title %><br></b>
          Rs. <%= listing.price.toLocaleString("en-PK") %> /night
          <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
        </p>


      </div>
    </div>
  </a>
  <% } %>
  <% } %>

</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }

    }
  });
</script>