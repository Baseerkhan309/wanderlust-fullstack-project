<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust</title>
  </head>
  <body>
    <h3>Edit Your Listing!</h3>
    <form>
      <input name="listing[title]" value=" <%= listing.title %> " type="text" />
      <br />
      <input name="listing[description]" value="<%= listing.description %>" />
      <br />
      <input name="listing[image]" value="<%= listing.image %>" type="text" />
      <br />
      <input name="listing[price]" value="<%= listing.price %>" type="number" />
      <br />
      <input
        name="listing[country]"
        value="<%= listing.country %>"
        type="text"
      />
      <br />
      <input
        name="listing[location]"
        value="<%= listing.location %>"
        type="text"
      />
      <br />

      <button>Edit</button>
    </form>
  </body>
</html>
